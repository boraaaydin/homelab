# Domain Settings
# The public URLs Cal.com serves (NEXT_PUBLIC_WEBAPP_URL, NEXT_PUBLIC_WEBSITE_URL,
# NEXT_PUBLIC_API_V2_URL, NEXTAUTH_URL) are built from these in docker-compose.yml,
# so there is nothing else to keep in sync:
#   domain access -> https://<DOMAIN_PREFIX>.<DOMAIN>   (leave HOST_PORT empty)
#   port access   -> http://localhost:<HOST_PORT>       (leave DOMAIN/DOMAIN_PREFIX empty)
DOMAIN=example.com
DOMAIN_PREFIX=calendar
HOST_PORT=

# Docker Settings
# Cal.com publishes one image per architecture, not a multi-arch manifest:
#   plain tags (latest, v6.2.0)  -> linux/amd64 only
#   '-arm' tags  (v6.2.0-arm)    -> linux/arm64 only, and there is no 'latest-arm',
#                                   so arm64 hosts have to pin a version
# Pick the pair that matches the host, otherwise the pull fails with
# "no matching manifest for linux/arm64/v8 in the manifest list entries":
#   Apple Silicon / ARM64 -> DOCKER_TAG=v6.2.0-arm  DOCKER_PLATFORM=linux/arm64
#   Intel / AMD64         -> DOCKER_TAG=latest      DOCKER_PLATFORM=linux/amd64
DOCKER_IMAGE=calcom.docker.scarf.sh/calcom/cal.com
DOCKER_TAG=v6.2.0-arm
DOCKER_PLATFORM=linux/arm64

# Secrets - run 'make secrets' to fill the empty ones automatically
NEXTAUTH_SECRET=
CALENDSO_ENCRYPTION_KEY=
JWT_SECRET=

# Database - shared PostgreSQL in this repo (../postgresql)
POSTGRES_HOST=postgres #leave as is if you are using the postgres container in this repo
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=calendso

# Redis - shared Valkey in this repo (../valkey)
REDIS_HOST=valkey #leave as is if you are using the valkey container in this repo
REDIS_PORT=6379
REDIS_PASSWORD=admin

# Cal.com Settings
NODE_ENV=production
LOG_LEVEL=info
NEXT_PUBLIC_LICENSE_CONSENT=agree # required to self-host, see https://cal.com/license
CALCOM_TELEMETRY_DISABLED=1
ORGANIZATIONS_ENABLED=0
IS_TEAM_BILLING_ENABLED=false
# Only needed for the commercial (EE) features. Leave the value empty,
# an inline comment on an empty value would be read as the value itself.
CALCOM_LICENSE_KEY=

# API v2 (only used with docker-compose.api.yml, see 'make up-api')
API_PORT=5555
API_KEY_PREFIX=cal_
REWRITE_API_V2_PREFIX=true
CALCOM_SOURCE_DIR=./source # path to a cal.com source checkout, required to build API v2

# Email - bookings and invitations are not sent until this is configured
EMAIL_FROM=notifications@example.com
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
