# Domain Configuration
# Choose one configuration method:

# Option 1: Domain-based access (through Traefik with SSL)
DOMAIN_PREFIX=zap
DOMAIN=example.com
# Access: https://zap.example.com/zap

# Option 2: Localhost access (direct port mapping)
HOST_PORT=8080
# Access: http://localhost:8080/zap

# ZAP Configuration
ZAP_VERSION=stable
# Available versions: stable, weekly, nightly

# Proxy Port Configuration
ZAP_PROXY_PORT=8090
# This is the port ZAP will use as a proxy for intercepting traffic

# Timezone
TZ=UTC
